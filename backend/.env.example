
# Application
APP_NAME=HCM Lite
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local development only — replace before production
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hcm_lite

# Frontend CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# xAI Grok — keep the real key only in backend environment variables
GROK_API_KEY= 
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
